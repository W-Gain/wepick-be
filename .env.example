# Kakao REST API 키를 입력하세요. JavaScript 키나 Admin 키가 아닙니다.
KAKAO_REST_API_KEY=
# 서버 전용 Client Secret입니다. 외부 Kakao 코드 교환을 실행할 때만 사용합니다.
KAKAO_CLIENT_SECRET=
# 기본 비활성화입니다. 키와 앱 설정을 확인한 뒤 활성화하세요.
KAKAO_LOGIN_ENABLED=false
# 로컬 HTTP callback 주소입니다. Vite 프록시를 거쳐 BE callback으로 전달됩니다.
KAKAO_REDIRECT_URI=http://127.0.0.1:5173/api/auth/kakao/callback
# 로컬 loopback HTTP에서만 사용합니다. HTTPS에서는 true로 설정하세요.
KAKAO_LOGIN_COOKIE_SECURE=false
# 위 로컬 HTTP callback용 명시적 opt-in입니다.
KAKAO_ALLOW_INSECURE_LOOPBACK_COOKIE=true
